// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
}

enum StatusAppointment {
  Done
  Pending
  Active
  Cancelled
}

enum TimeType {
  morning
  afternoon
  evening
}

enum StatusDoctor {
  inactive
  active
}

enum Role {
  patient
  doctor
  admin
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  gender       Gender
  email        String        @unique @db.VarChar(200)
  phone        String        @db.VarChar(50)
  password     String        @db.VarChar(50)
  datebirth    DateTime
  refreshToken String?       @map("refresh_token") // refresh token hiện tại, dùng để revoke
  role         Role?         @default(patient)
  isDelete     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  appointments Appointment[]
  histories    History[]
  bills        Bill[]
  doctors      Doctor[]

  @@map("User")
}

model Appointment {
  id          Int               @id @default(autoincrement())
  userId      Int?              @map("user_Id")
  doctorId    Int?              @map("doctor_id")
  date        DateTime          @default(now()) @map("date")
  timeType    TimeType          @map("Time_Type")
  status      StatusAppointment @map("status")
  description String            @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor?           @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("Appointment")
}

model Doctor {
  id           Int           @id @default(autoincrement())
  userId       Int?          @unique @map("user_id")
  status       StatusDoctor  @default(active)
  departmentId Int?          @map("department_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  histories    History[]
  bills        Bill[]
  timeSlots    timeSlot[]

  @@map("doctor")
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

model timeSlot {
  id        Int       @id @default(autoincrement())
  doctorId  Int?      @map("doctor_id")
  dayOfWeek DayOfWeek @default(monday)
  date      DateTime  @db.Date
  startTime DateTime  @map("start_time")
  endTime   DateTime  @map("end_timetime")
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  
  doctor    Doctor?   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@map("time_slots")
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  doctors   Doctor[]
  medicals  Medical[]

  @@map("Department")
}

model History {
  id          Int      @id @default(autoincrement())
  description String   @db.VarChar(500)
  date        DateTime @default(now())
  doctorId    Int?     @map("doctor_id")
  patientId   Int?     @map("patient_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  bill   Bill?

  @@map("History")
}

model Medical {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  departmentId Int?    @map("department_id")
  price        Float
  quantity     Int     @default(0)
  isService    Boolean @default(false)
  description  String  @db.VarChar(200)

  department Department? @relation(fields: [departmentId], references: [id])
  billItems  BillItem[]

  @@map("medical")
}

model Bill {
  id        Int      @id @default(autoincrement())
  doctorId  Int?     @map("doctor_id")
  patientId Int?     @map("patient_id")
  historyId Int?     @unique @map("history_id")
  totalCost Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  doctor  Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  user    User?      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  history History?   @relation(fields: [historyId], references: [id], onDelete: SetNull)
  items   BillItem[]

  @@map("bill")
}

model BillItem {
  id         Int   @id @default(autoincrement())
  billId     Int   @map("bill_id")
  medicianId Int   @map("medician_id")
  quantity   Int
  cost       Float

  bill     Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  medician Medical? @relation(fields: [medicianId], references: [id])

  @@map("bill_item")
}
