// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
}

enum StatusAppointment {
  Done
  Pending
  Active
  Cancelled
}

enum TimeType {
  morning
  afternoon
  evening
}

enum StatusDoctor {
  inactive
  active
}

enum Role {
  patient
  doctor
  admin
}

model Patient {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  gender       Gender
  email        String        @unique @db.VarChar(200)
  phone        String        @db.VarChar(50)
  password     String        @db.VarChar(50)
  datebirth    DateTime
  tokenUser    String?       @db.VarChar(255)
  user         Role?         @default(user)
  isDelete     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  appointments Appointment[]
  histories    History[]
  bills        Bill[]

  @@map("patient")
}

model Appointment {
  id          Int               @id @default(autoincrement())
  patientId   Int?              @map("patient_id")
  doctorId    Int?              @map("doctor_id")
  date        DateTime          @default(now()) @map("date")
  timeType    TimeType          @map("Time_Type")
  status      StatusAppointment @map("status")
  description String            @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")
  patient     Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctor      Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@map("Appointment")
}

model Doctor {
  id           Int          @id @default(autoincrement())
  fullname     String       @db.VarChar(100)
  gender       Gender
  datebirth    DateTime
  email        String       @db.VarChar(200)
  phone        String       @db.VarChar(50)
  password     String       @db.VarChar(100)
  tokenDoctor  String?      @db.VarChar(255)
  status       StatusDoctor @default(active)
  user         Role?        @default(user)
  isDelete     Boolean      @default(false)
  departmentId Int?         @map("department_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  Department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  histories    History[]
  bills        Bill[]

  @@map("doctor")
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  doctors   Doctor[]
  medicals  Medical[]

  @@map("Special")
}

model History {
  id          Int      @id @default(autoincrement())
  description String   @db.VarChar(500)
  date        DateTime @default(now())
  doctorId    Int?     @map("doctor_id")
  patientId   Int?     @map("patient_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  doctor  Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  bill    Bill?

  @@map("History")
}

model Medical {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  departmentId Int?    @map("department_id")
  price        Float
  quantity     Int     @default(0)
  isService    Boolean @default(false)
  description  String  @db.VarChar(200)

  department Department? @relation(fields: [departmentId], references: [id])
  billItems  BillItem[]

  @@map("medical")
}

model Bill {
  id        Int      @id @default(autoincrement())
  doctorId  Int?     @map("doctor_id")
  patientId Int?     @map("patient_id")
  historyId Int?     @unique @map("history_id")
  totalCost Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  doctor  Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient Patient?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  history History?   @relation(fields: [historyId], references: [id], onDelete: SetNull)
  items   BillItem[]

  @@map("bill")
}

model BillItem {
  id         Int   @id @default(autoincrement())
  billId     Int   @map("bill_id")
  medicianId Int   @map("medician_id")
  quantity   Int
  cost       Float

  bill     Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  medician Medical? @relation(fields: [medicianId], references: [id])

  @@map("bill_item")
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  password     String
  refreshToken String?
  user         Role?    @default(admin)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("Admins")
}
